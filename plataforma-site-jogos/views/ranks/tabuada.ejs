<!DOCTYPE html>
<html lang="pt-br">

<head>
    <%- include('../templates/head.html') %>
</head>

<body>
    <%- include('../templates/header.html') %>

    <main>
        <div class="container py-5">
            <div class="rounded p-4 mb-4 text-center" style="background-color: black;">
                <h1 class="display-5 fw-bold" style="color:#4EBF5F">Rankings — Tabuada</h1>
                <p class="lead mb-0 text-light">Resultados por desafio</p>
            </div>

            <% tabuadas.forEach(t => { %>
            <section class="mb-4">
                <div class="row">
                    <div class="col-12">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title"><%= t.desafio %></h5>
                                <div class="table-responsive table-scroll">
                                    <table class="table table-sm table-striped mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Nº</th>
                                                <th>Nome</th>
                                                <% if (!t.desafio.toLowerCase().includes('acerto')) { %><th>Acertos</th><% } %>
                                                <% if (!t.desafio.toLowerCase().includes('erro')) { %><th>Erros</th><% } %>
                                                <% if (!t.desafio.toLowerCase().includes('minuto')) { %><th>Tempo</th><% } %>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% let c = 0 %>
                                            <% pontuacoes.forEach(p => { %>
                                                <% if (p.jogoId == t.id) { %>
                                                    <% c++ %>
                                                    <tr>
                                                        <td><%= c %></td>
                                                        <td><%= p.nome %></td>
                                                        <% if (!t.desafio.toLowerCase().includes('acerto')) { %><td><%= p.pontuacao %></td><% } %>
                                                        <% if (!t.desafio.toLowerCase().includes('erro')) { %><td><%= p.erros %></td><% } %>
                                                        <% if (!t.desafio.toLowerCase().includes('minuto')) { %><td><%= p.tempo %></td><% } %>
                                                    </tr>
                                                <% } %>
                                            <% }) %>
                                            <% if (c === 0) { %>
                                                <tr>
                                                    <td colspan="5" class="text-center">Nenhum resultado cadastrado para este desafio.</td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <% }) %>

        </div>
    </main>

    <%- include('../templates/footer.html') %>
</body>

</html>