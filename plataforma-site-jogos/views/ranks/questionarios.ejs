<!DOCTYPE html>
<html lang="pt-br">

<head>
    <%- include('../templates/head.html') %>
    <link rel="stylesheet" href="../../css/maratona.css">
</head>

<body>
    <%- include('../templates/header.html') %>

    <main>
        <div class="container py-5">
            <div class="rounded p-4 mb-4 text-center" style="background-color: black;">
                <h1 class="display-5 fw-bold" style="color:#4EBF5F">Questionário — Rankings</h1>
                <p class="lead mb-0 text-light">Resultados do questionário</p>
            </div>

            <section class="mb-4">
                <div class="row">
                    <div class="col-12">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title"><%= quiz[0].nome_questionario %></h5>
                                <div class="table-responsive table-scroll">
                                    <table class="table table-sm table-striped mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Nº</th>
                                                <th>Nome</th>
                                                <th>Pontuação</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% pontuacoes.forEach((p, i)=> { %>
                                            <tr>
                                                <td><%= i + 1 %>º</td>
                                                <td><%= usuarios.find(o=> o.id === p.usuarioId).nome %></td>
                                                <td><%= p.pontuacao %>/<%= p.total %></td>
                                            </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

        </div>
    </main>

    <%- include('../templates/footer.html') %>

</body>

</html>